{
  "name": "@jackcom/raphsducks",
  "version": "3.2.4",
  "description": "A lightweight pubsub (publish-subscribe) state manager.",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./lib/types": {
      "import": {
        "types": "./lib/types.d.mts",
        "default": "./lib/types.mjs"
      },
      "require": {
        "types": "./lib/types.d.ts",
        "default": "./lib/types.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "state",
    "manager",
    "global",
    "publish",
    "subscribe"
  ],
  "author": "JACKCOM",
  "repository": {
    "type": "git",
    "url": "https://github.com/JACK-COM/raphsducks.git"
  },
  "license": "WTFPL",
  "scripts": {
    "clean": "rm -rf lib/",
    "build": "tsup && tsc --emitDeclarationOnly && node scripts/emit-dts.mjs",
    "deploy": "npm run build && npm pack && npm publish",
    "deploy:black": "npm run build && npm pack && npm publish --tag black",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test-watch": "jest --watchAll --testTimeout=300000 --detectOpenHandles",
    "test": "jest --testTimeout=300000 --detectOpenHandles",
    "preview": "npm run build && npm pack && rm -rf *.tgz",
    "prepublish": "npm run build",
    "postpublish": "git push origin --tags",
    "prepare": "husky",
    "bamp-patch": "npm version patch -m \"%s\"",
    "bamp-minor": "npm version minor -m \"%s\"",
    "bamp-major": "npm version major -m \"%s\""
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "immutable": "^5.1.9"
  },
  "allowScripts": {
    "@swc/core@1.16.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
