{
  "name": "@jackcom/raphsducks",
  "version": "3.1.1",
  "description": "A lightweight pubsub (publish-subscribe) state manager.",
  "main": "lib/index.js",
  "keywords": [
    "state",
    "manager",
    "global",
    "publish",
    "subscribe"
  ],
  "author": "JACKCOM",
  "repository": {
    "type": "git",
    "url": "https://github.com/JACK-COM/raphsducks.git"
  },
  "license": "WTFPL",
  "scripts": {
    "clean": "rm -rf lib/",
    "build": "tsc",
    "prebuild": "npm run clean",
    "postbuild": "make compress",
    "deploy": "npm run build && npm pack && npm publish",
    "deploy:black": "npm run build && npm pack && npm publish --tag black",
    "test-watch": "jest --watchAll --testTimeout=300000 --detectOpenHandles",
    "test": "jest --testTimeout=300000 --detectOpenHandles",
    "preview": "npm run build && npm pack && rm -rf *.tgz",
    "prepublish": "npm run build",
    "postpublish": "git push origin --tags",
    "prepare": "husky",
    "bamp-patch": "npm version patch -m \"%s\"",
    "bamp-minor": "npm version minor -m \"%s\"",
    "bamp-major": "npm version major -m \"%s\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "immutable": "^5.1.5"
  }
}
