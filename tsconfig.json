{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "resolveJsonModule": true,
    "sourceMap": false,
    "strict": true,
    "stripInternal": true,
    "target": "es2020",
    "useDefineForClassFields": true,
    "types": ["node", "jest"]
  },
  "include": ["./src/**/*"],
  "exclude": ["./node_modules", "./lib", "./**/*.test.*"]
}
